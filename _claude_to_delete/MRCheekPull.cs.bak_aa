using System.Collections.Generic;
using UnityEngine;

// 볼당기기 — MR판. 캐릭터 루트에 런타임으로 붙는다 (MRCheekPullBinder가 붙인다).
//
// 데스크톱판 CheekPullHandler는 IDragHandler + 화면 좌표(ScreenPointToRay)를 썼다.
// MR에는 의미 있는 화면 좌표가 없고, 3D 콜라이더에 uGUI 이벤트를 보내려면
// PhysicsRaycaster가 있어야 하는데 MR 씬에는 0개다(2026-08-26 실측).
// 그래서 입력은 Oculus Interaction(RayInteractable / HandGrabInteractable)으로 받고,
// 이동은 이 스크립트가 LateUpdate에서 직접 적용한다.
//
// **LateUpdate여야 하는 이유**: Animator는 Update 이후에 본 포즈를 자기 값으로 되돌린다.
// Update에서 본을 옮기면 그 프레임 안에 지워진다. 데스크톱판도 같은 이유로 LateUpdate였다.
public class MRCheekPull : MonoBehaviour
{
    [Header("당기기")]
    [Tooltip("본 기준 로컬 최대 이동 거리(m). 실측 로그의 '월드 반지름'을 보고 조정할 것.")]
    [SerializeField] private float maxPullDistance = 0.06f;

    [Tooltip("잡은 손을 따라가는 속도. 클수록 즉각적, 작을수록 부드럽다.")]
    [SerializeField] private float followSpeed = 30f;

    [Header("복귀")]
    [Tooltip("놓았을 때 제자리로 돌아가는 시간(초).")]
    [SerializeField] private float returnDuration = 0.25f;

    [Tooltip("복귀할 때 반대쪽으로 살짝 넘어갔다 돌아온다(탱 하는 느낌). 0이면 그냥 미끄러져 돌아온다.")]
    [SerializeField] private float overshoot = 1.7f;

    [Header("연출")]
    [SerializeField] private string pullEmotion = "><";
    [SerializeField] private string releaseEmotion = "idle";
    [SerializeField] private string animatorBoolName = "isCheekPull";

    [Header("진단")]
    [Tooltip("배선 직후 각 볼의 실제 월드 크기를 한 줄 찍는다. 정적 분석으로는 루트 스케일을 알 수 없어서다.")]
    [SerializeField] private bool logMeasurementOnBind = true;

    // 볼 하나의 상태.
    private class Cheek
    {
        public string name;
        public Transform bone;
        public Vector3 restLocalPos;      // 본의 원래 로컬 위치(기준점)
        public Vector3 currentOffset;     // 지금 적용 중인 로컬 오프셋
        public Vector3 targetOffset;      // 손이 지시하는 목표 로컬 오프셋
        public bool isPulling;
        public Vector3 releaseOffset;     // 놓는 순간의 오프셋(복귀 보간 시작점)
        public float releaseTimer;        // 복귀 경과 시간
        public bool isReturning;
    }

    private readonly List<Cheek> _cheeks = new List<Cheek>();
    private Animator _animator;
    private bool _animatorHasBool;
    private bool _animatorChecked;
    private int _pullingCount;

    // =========================================================
    // 배선 (MRCheekPullBinder가 부른다)
    // =========================================================

    // 튜닝 값을 밖에서 주입한다.
    //
    // 이 컴포넌트는 런타임 AddComponent로 붙기 때문에 씬/프리팹에 인스펙터 값이 없다.
    // 즉 아래 [SerializeField] 기본값을 **아무도 고칠 수 없다**.
    // 그래서 씬에 실재하는 MRCheekPullBinder가 값을 갖고, 배선할 때와 매 프레임 밀어 넣는다.
    // (Play 중에 바인더 인스펙터를 만지면 바로 반영돼 감을 잡기 쉽다.)
    public void Configure(float maxPull, float follow, float returnDur, float over)
    {
        maxPullDistance = maxPull;
        followSpeed = follow;
        returnDuration = returnDur;
        overshoot = over;
    }

    public int RegisterCheek(Transform bone, string label)
    {
        if (bone == null)
        {
            return -1;
        }

        Cheek c = new Cheek();
        c.name = label;
        c.bone = bone;
        c.restLocalPos = bone.localPosition;
        _cheeks.Add(c);

        if (logMeasurementOnBind)
        {
            Vector3 ls = bone.lossyScale;
            float worldRadius = 0f;
            SphereCollider sphere = bone.GetComponent<SphereCollider>();
            if (sphere != null)
            {
                worldRadius = sphere.radius * Mathf.Max(ls.x, Mathf.Max(ls.y, ls.z));
            }
            // 정적 분석에서는 루트 스케일이 중첩 프리팹이라 미해결이었다. 런타임 값이 유일한 진실이다.
            Debug.Log($"[MRCheekPull/실측] {label} | lossyScale={ls.ToString("F4")} | " +
                      $"콜라이더 월드 반지름={worldRadius:F4}m (지름 {worldRadius * 200f:F1}cm) | " +
                      $"본 로컬 기준점={c.restLocalPos.ToString("F4")} | maxPullDistance={maxPullDistance:F3}m");
        }

        return _cheeks.Count - 1;
    }

    public void SetupAnimator(Animator animator)
    {
        _animator = animator;
        _animatorHasBool = false;
        _animatorChecked = false;
        TryResolveAnimatorBool();
    }

    // 애니메이터 bool 파라미터가 있는지 확인한다. 아직 준비 전이면 false를 반환하고,
    // 나중에(첫 당김) 다시 시도한다.
    //
    // 2026-08-26 실측 사고: 스폰 직후에는 컨트롤러가 아직 바인딩되지 않아
    // "Animator is not playing an AnimatorController" 경고가 나고,
    // 그 상태의 parameterCount는 **실제 개수보다 큰 값**을 돌려준다.
    // GetParameter(i)를 그대로 돌리면 IndexOutOfRangeException이 터진다.
    // parameterCount + GetParameter 대신 parameters 배열을 쓰고, 준비 여부를 먼저 본다.
    private bool TryResolveAnimatorBool()
    {
        if (_animatorChecked)
        {
            return true;
        }
        if (_animator == null)
        {
            _animatorChecked = true;
            return true;
        }
        if (string.IsNullOrEmpty(animatorBoolName))
        {
            _animatorChecked = true;
            return true;
        }

        // 컨트롤러가 붙기 전에는 파라미터를 물어보면 안 된다.
        if (_animator.runtimeAnimatorController == null)
        {
            return false;
        }
        if (!_animator.isInitialized)
        {
            return false;
        }

        AnimatorControllerParameter[] ps = _animator.parameters;
        for (int i = 0; i < ps.Length; i++)
        {
            if (ps[i].type == AnimatorControllerParameterType.Bool && ps[i].name == animatorBoolName)
            {
                _animatorHasBool = true;
                break;
            }
        }

        _animatorChecked = true;

        string boolText = "없음(무시)";
        if (_animatorHasBool)
        {
            boolText = "있음";
        }
        Debug.Log($"[MRCheekPull] 애니메이터 파라미터 확인 | '{animatorBoolName}' {boolText} | 파라미터 {ps.Length}개");
        return true;
    }

    // =========================================================
    // 트랜스포머가 부르는 입구
    // =========================================================
    public void BeginPull(int index, Vector3 grabWorldPos)
    {
        Cheek c = Get(index);
        if (c == null)
        {
            return;
        }

        c.isPulling = true;
        c.isReturning = false;
        _pullingCount++;

        ApplyPullPresentation(true);
        Debug.Log($"[MRCheekPull] {c.name} 잡음 | 잡은 지점={grabWorldPos.ToString("F3")}");
    }

    public void UpdatePull(int index, Vector3 grabWorldPos)
    {
        Cheek c = Get(index);
        if (c == null)
        {
            return;
        }
        if (!c.isPulling)
        {
            return;
        }
        if (c.bone.parent == null)
        {
            return;
        }

        // 본의 기준 월드 위치(머리가 움직여도 따라간다)
        Vector3 restWorld = c.bone.parent.TransformPoint(c.restLocalPos);

        // 최대 거리는 **월드 미터**로 제한한다.
        //
        // 예전에는 로컬 공간에서 잘랐는데, 리그에 스케일이 걸려 있으면 로컬 1단위가 1m가 아니다.
        // 그러면 maxPullDistance=0.06이 실제로 몇 cm인지 예측할 수 없고,
        // 캐릭터마다 체감이 달라진다. 월드에서 자르면 숫자가 곧 미터다.
        Vector3 worldOffset = grabWorldPos - restWorld;
        if (worldOffset.magnitude > maxPullDistance)
        {
            worldOffset = worldOffset.normalized * maxPullDistance;
        }

        // 자른 뒤에 본 부모의 로컬 공간으로 변환한다 (스케일은 여기서 알아서 반영된다).
        c.targetOffset = c.bone.parent.InverseTransformVector(worldOffset);
    }

    public void EndPull(int index)
    {
        Cheek c = Get(index);
        if (c == null)
        {
            return;
        }
        if (!c.isPulling)
        {
            return;
        }

        c.isPulling = false;
        c.isReturning = true;
        c.releaseOffset = c.currentOffset;
        c.releaseTimer = 0f;
        c.targetOffset = Vector3.zero;

        _pullingCount--;
        if (_pullingCount < 0)
        {
            _pullingCount = 0;
        }

        // 로컬 오프셋을 월드 길이로 되돌려 찍는다. 로컬 단위를 미터라고 부르면 거짓말이 된다.
        float worldPulled = c.releaseOffset.magnitude;
        if (c.bone.parent != null)
        {
            worldPulled = c.bone.parent.TransformVector(c.releaseOffset).magnitude;
        }
        Debug.Log($"[MRCheekPull] {c.name} 놓음 | 당긴 거리={worldPulled:F4}m (최대 {maxPullDistance:F3}m)");

        if (_pullingCount == 0)
        {
            ApplyPullPresentation(false);
        }
    }

    // =========================================================
    // 적용 — Animator 뒤에서 돈다
    // =========================================================
    private void LateUpdate()
    {
        for (int i = 0; i < _cheeks.Count; i++)
        {
            Cheek c = _cheeks[i];
            if (c.bone == null)
            {
                continue;
            }

            if (c.isPulling)
            {
                // 손을 부드럽게 따라간다
                c.currentOffset = Vector3.Lerp(c.currentOffset, c.targetOffset,
                                               1f - Mathf.Exp(-followSpeed * Time.deltaTime));
            }
            else if (c.isReturning)
            {
                c.releaseTimer += Time.deltaTime;
                float t = 1f;
                if (returnDuration > 0f)
                {
                    t = Mathf.Clamp01(c.releaseTimer / returnDuration);
                }

                // 1에서 0으로 가되 살짝 반대편으로 넘어갔다 돌아온다
                float k = 1f - EaseOutBack(t);
                c.currentOffset = c.releaseOffset * k;

                if (t >= 1f)
                {
                    c.currentOffset = Vector3.zero;
                    c.isReturning = false;
                }
            }

            // Animator가 이미 본을 자기 포즈로 되돌린 뒤다. 여기서 오프셋을 다시 얹는다.
            c.bone.localPosition = c.restLocalPos + c.currentOffset;
        }
    }

    // 되돌아올 때 살짝 넘어가는 곡선. overshoot=0이면 평범한 감속이 된다.
    private float EaseOutBack(float t)
    {
        float c1 = overshoot;
        float c3 = c1 + 1f;
        float u = t - 1f;
        return 1f + c3 * u * u * u + c1 * u * u;
    }

    private void ApplyPullPresentation(bool pulling)
    {
        // 배선 시점에 컨트롤러가 준비 안 됐을 수 있다. 실제로 쓸 때 한 번 더 본다.
        TryResolveAnimatorBool();

        if (_animatorHasBool)
        {
            _animator.SetBool(animatorBoolName, pulling);
        }

        if (EmotionManager.Instance == null)
        {
            return;
        }

        string emotion = releaseEmotion;
        if (pulling)
        {
            emotion = pullEmotion;
        }
        if (string.IsNullOrEmpty(emotion))
        {
            return;
        }
        EmotionManager.Instance.ShowEmotion(emotion, gameObject);
    }

    private Cheek Get(int index)
    {
        if (index < 0)
        {
            return null;
        }
        if (index >= _cheeks.Count)
        {
            return null;
        }
        return _cheeks[index];
    }
}
